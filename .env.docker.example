POSTGRES_DB=talent_mobility
POSTGRES_USER=talent_mobility
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
DATABASE_URL=postgres://talent_mobility:replace_with_a_long_random_url_safe_password@db:5432/talent_mobility
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
RUST_LOG=info,tower_http=info

# Required on first deployment to seed the Super Admin. Replace before starting Docker.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: set both VAPID keys to enable browser push notifications.
# Generate a pair with: npx --yes web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# Kata sandi awal akun pelamar (wajib, minimal 6 karakter). Pelamar wajib menggantinya saat masuk pertama.
DEFAULT_APPLICANT_PASSWORD=REPLACE_WITH_INITIAL_PASSWORD
