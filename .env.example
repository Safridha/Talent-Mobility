DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/talent_mobility
APP_ADDR=127.0.0.1:8000
RUST_LOG=info,tower_http=info
APP_PUBLIC_URL=http://127.0.0.1:8000

# Configure SMTP to enable password reset links.
# Use an app-specific password where supported; keep these values private.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=talent-mobility@example.com
# SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM=Talent Mobility <talent-mobility@example.com>

# Set all three to create the initial administrator if the email is not already registered.
# Use a unique password with 8-128 characters: uppercase, lowercase, number, and symbol.
# ADMIN_NAME="Talent Mobility Admin"
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Optional Web Push configuration. Keep the private key secret.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
