# Staging (compose.staging.yaml). File .env.staging dibuat otomatis oleh `scripts/deploy-staging.ps1`
# dengan kredensial acak, dan tidak ikut di-commit. Salin file ini hanya jika ingin mengisinya manual.
# Jangan pernah memakai rahasia produksi di sini.

STAGING_PORT=8010
STAGING_PUBLIC_URL=https://emtopro-staging.4connectivity.my.id
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin-staging@example.test
ADMIN_PASSWORD=
DEFAULT_APPLICANT_PASSWORD=

# Cloudflare Turnstile dimatikan di staging: biarkan kosong (tanpa widget, tanpa verifikasi).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
